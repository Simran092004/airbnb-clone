<% layout('layouts/boilerplate') -%>
  <script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
  </script>
  <div class="row mt-3 mb-3">
    <!-- HEADING -->
    <div class="col-8 offset-2 mt-2 mb-2">
      <h3>Listing Details:</h3>
    </div>
    <!-- LISTING CARD -->
    <div class="card col-8 offset-2 mb-3 show-card">
      <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="Property Image" />
      <div class="card-body mt-3">
        <p class="card-text ">
          <h5><b>
            <%= listing.title %>
          </b></h5>
          Owned By:
          <%= listing.owner.username %><br />
            <%= listing.description %><br />
              &#8377;
              <%= listing.price.toLocaleString("en-IN") %><br />
                <%= listing.location %><br />
                  <%= listing.country %>
        </p>
      </div>
    </div>
      <!-- EDIT DELETE BUTTONS -->
      <% if(currentUser && listing.owner._id.equals(currentUser._id)) { %>
        <div class="btns mt-3 mb-4">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn col-1 offset-2">
            Edit
          </a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-dark del-btn offset-2">
              Delete
            </button>
          </form>
        </div>
        <% } %>
    <!-- CALENDAR + REVIEWS SECTION -->
    <div class="row mt-4 gy-4">
      <!-- LEFT SIDE -->
      <div class="col-12 col-md-6 offset-md-2">
        <div class="reviews mt-3 mb-5">
          <h4>Leave a Review</h4>
          <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
            <!-- STAR RATING -->
            <div class="mb-3 mt-3">
              <fieldset class="starability-slot">
                <legend class="form-label"></legend>
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1">
                  1 star
                </label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2">
                  2 stars
                </label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3">
                  3 stars
                </label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4">
                  4 stars
                </label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5">
                  5 stars
                </label>
              </fieldset>
            </div>
            <!-- COMMENT -->
            <div class="mb-3 mt-3">
              <label for="comment" class="form-label">
                Comment
              </label>
              <textarea name="review[comment]" cols="30" rows="5" class="form-control" required></textarea>
              <div class="invalid-feedback">
                Please add some comments for your review!
              </div>
            </div>
            <button class="btn btn-outline-dark mt-2">
              Submit Review
            </button>
          </form>
        </div>
      </div>
      <!-- RIGHTSIDE -->
      <div class="col-12 col-md-4 mt-4">
            <h5>Calender :</h5>
            <div class="mt-2" id="bookingCalendar"></div>
          <div class="col-md-3 mt-4">
            <a href="/bookings/<%= listing._id %>" class="btn btn-dark reserve-btn mb-4">
              Reserve
            </a>
          </div>
      </div>
    </div>
    <br>
      <div class="col-9 offset-2 mt-2 mb-4">
          <!-- ALL REVIEWS -->
          <% if(listing.reviews.length> 0) { %>
            <div class="row">
              <h5 class="mb-3">All Reviews:</h5>
              <% for(review of listing.reviews) { %>
                <div class="card bordered-card col-5 ms-3 mb-3">
                  <div class="card-body">
                    <h5 class="card-title">
                      @<%= review.author.username %>
                    </h5>
                    <p class="starability-result card-text" data-rating="<%= review.rating %>">
                    </p>
                    <p class="card-text">
                      <%= review.comment %>
                    </p>
                  </div>
                  <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                    <button class="btn btn-sm btn-dark mt-3 mb-3">
                      Delete
                    </button>
                  </form>
                </div>
                <% } %>
            </div>
            <% } %>
      </div>
    <!-- MAP -->
    <div class="col-9 offset-2 mt-2 mb-4">
      <h3>Where you'll be :</h3>
      <div id="map" style="width: 100%; height: 400px;"></div>
    </div>
  </div>
  <!-- MAP SCRIPT -->
  <script src="/js/map.js"></script>
  <!-- CALENDAR SCRIPT -->
  <script>
    const reservedDates = [
    <% activeBookings.forEach((booking, index) => { %>
    {
      checkIn: new Date("<%= booking.checkIn.toISOString() %>"),
      checkOut: new Date("<%= booking.checkOut.toISOString() %>")
    }
      <%= index < activeBookings.length - 1 ? "," : "" %>
    <% }) %>
  ];
    flatpickr("#bookingCalendar", {
      inline: true,
      mode: "range",
      minDate: "today",
      disable: reservedDates.map(date => ({
        from: date.checkIn,
        to: date.checkOut
      })),
      onDayCreate: function (dObj, dStr, fp, dayElem) {
        const currentDate = new Date(dayElem.dateObj);
        currentDate.setHours(0, 0, 0, 0);
        reservedDates.forEach(date => {
          const checkIn = new Date(date.checkIn);
          const checkOut = new Date(date.checkOut);
          checkIn.setHours(0, 0, 0, 0);
          checkOut.setHours(0, 0, 0, 0);
          if (currentDate.getTime() === checkIn.getTime()) {
            dayElem.style.background = "#ff385c";
            dayElem.style.color = "white";
            dayElem.style.borderRadius = "50%";
          }
          if (currentDate.getTime() === checkOut.getTime()) {
            dayElem.style.background = "#ff385c";
            dayElem.style.color = "white";
            dayElem.style.borderRadius = "50%";
          }
        });
      }
    });
  </script>